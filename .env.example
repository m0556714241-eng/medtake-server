# כתובת מסד הנתונים (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medtake"

# מפתח סודי לחתימת JWT – מחרוזת אקראית ארוכה (לפחות 32 תווים). לעולם לא להעלות לגיט!
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# תוקף ה-Token
JWT_EXPIRES_IN="7d"

# הפורט של השרת (ב-Render נקבע אוטומטית)
PORT=3000

# כתובות הלקוח שמורשות לפנות לשרת, מופרדות בפסיק
CORS_ORIGIN="http://localhost:5173"

# development / production / test
NODE_ENV="development"

# סיסמה למשתמשי ההדגמה שה-Seed יוצר (אופציונלי בפיתוח, חובה בפרודקשן)
SEED_PASSWORD="Medtake123"
